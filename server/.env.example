# farm-server 本地开发环境变量示例。只放变量名与本地占位值，禁止提交真实 Secret。
# 完整清单与语义见 05-配置与环境变量.md。

APP_ENV=local
# 每个进程单独设置：gatesvr / farmsvr / gamesvr / workersvr
SERVICE_NAME=gatesvr
INSTANCE_ID=local-1

HTTP_LISTEN_ADDR=:8080
GRPC_LISTEN_ADDR=:9090
NATIVE_GRPC_LISTEN_ADDR=:9092
DIAG_LISTEN_ADDR=:9091
LOG_LEVEL=info

# MySQL 权威库（gamesvr/workersvr 必填；gatesvr/farmsvr 可留空）
# 格式：user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=True&loc=UTC
MYSQL_DSN=<your-mysql-dsn>

# Redis（gatesvr/farmsvr 必填）
REDIS_ADDRS=<host:port>
REDIS_PASSWORD=<your-redis-password>

# Route 9.4 multi-instance discovery/routing. Empty only in local static mode.
ETCD_ENDPOINTS=<host:2379>
ETCD_PREFIX=/farm-server/v1
# Per process, advertise addresses reachable by the other services.
ADVERTISE_HTTP_ADDR=http://127.0.0.1:8080
ADVERTISE_GRPC_ADDR=127.0.0.1:9092
ROUTE_BUCKET_COUNT=1024
ROUTE_LEASE_TTL=15s
ROUTE_RECONCILE_INTERVAL=1s
PUBSUB_UNSUBSCRIBE_DELAY=5s

# 事件总线：memory 仅用于 local/test；devcloud/stress 必须 kafka
EVENT_BUS_DRIVER=memory
# driver=kafka 时必填（host:port，逗号分隔）
KAFKA_BROKERS=<host:port>
# Defaults preserve the existing production topic/group names. Override both
# for an isolated acceptance environment or tenant.
KAFKA_TOPIC=farm-events
KAFKA_CONSUMER_GROUP_PREFIX=workersvr
# 消费处理有限重试；耗尽后可靠写入 consumer_failed_events 再提交 offset
KAFKA_CONSUMER_MAX_TRIES=5
KAFKA_CONSUMER_RETRY_MIN=250ms
KAFKA_CONSUMER_RETRY_MAX=4s
# Relay drains continuously while backlog exists and backs off when empty.
OUTBOX_RELAY_BATCH_SIZE=50
OUTBOX_RELAY_POLL_INTERVAL=1s
OUTBOX_RELAY_DRAIN_INTERVAL=10ms
OUTBOX_RELAY_LOCK_TTL=30s
OUTBOX_RELAY_MAX_RETRY=5
# Pet scheduling is independent from Relay drain work.
PET_SCAN_INTERVAL=1s
PET_SCAN_BATCH_SIZE=50
# 路线 10.2 保留期清理（workersvr）。任一项设为 0s 即关闭该表清理。
# 不清理 DEAD outbox（须先告警/审计/支持人工重放）和 economy_transactions
# （权威幂等与账本，只能归档后分区清理）。
RETENTION_SCAN_INTERVAL=5m
RETENTION_BATCH_SIZE=500
RETENTION_MAX_ROWS_PER_RUN=20000
# 已投递事实，Kafka 承接后续传播
RETENTION_OUTBOX_PUBLISHED=48h
# 必须覆盖客户端 ACK 丢失后的重试窗口
RETENTION_CMD_RECEIPTS=72h
# 必须覆盖 Kafka topic retention，否则重投消息会被重复消费
RETENTION_CONSUMED_EVENTS=168h

GRACEFUL_SHUTDOWN_TIMEOUT=30s

# Route 9.3 native gRPC dual stack. HTTP keeps serving on GRPC_LISTEN_ADDR.
GAMESVR_ADDR=http://localhost:9090
FARMSVR_ADDR=http://localhost:8081
GAMESVR_GRPC_ADDR=localhost:9092
FARMSVR_GRPC_ADDR=localhost:9093
RPC_TRANSPORT=http
RPC_DEFAULT_TIMEOUT=3s
RPC_KEEPALIVE_TIME=30s
RPC_KEEPALIVE_TIMEOUT=10s
RPC_MAX_MESSAGE_BYTES=1048576
RPC_MAX_CONCURRENT_STREAMS=128

# Route 9.2 bounded Actor runtime; production values must come from load tests.
REALTIME_SCHEDULER_SHARD_COUNT=64
REALTIME_WORKER_COUNT=64
REALTIME_FARM_FIFO_CAPACITY=8
REALTIME_READY_QUEUE_CAPACITY=128
REALTIME_INGRESS_CAPACITY=256
REALTIME_ACTOR_MAX_ACTIVE=100000
REALTIME_QUEUE_WAIT_TIMEOUT=5ms
REALTIME_COMMAND_TIMEOUT=3s
REALTIME_ACTOR_IDLE_EVICT_AFTER=5m

CORE_GLOBAL_MAX_INFLIGHT=20
MYSQL_TOTAL_CONNECTION_BUDGET=200
GAMESVR_EXPECTED_INSTANCES=8
CORE_ADMISSION_WAIT_TIMEOUT=5ms
GATEWAY_READ_CACHE_TTL=2s
GATEWAY_READ_CACHE_STALE_TTL=30s
GATEWAY_READ_CACHE_TIMEOUT=25ms
OVERLOAD_RETRY_AFTER=50ms
GATEWAY_HTTP_RPS_PER_USER=10
GATEWAY_HTTP_BURST_PER_USER=20
GATEWAY_HTTP_RPS_PER_IP=50
GATEWAY_HTTP_BURST_PER_IP=100
# Optional non-WebSocket public HTTP bound. Zero preserves existing behavior.
GATEWAY_GLOBAL_MAX_INFLIGHT=0
